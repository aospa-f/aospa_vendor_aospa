<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.axion.axionparts"
    android:sharedUserId="android.uid.system">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".DeviceManagerActivity"
            android:exported="true"
            android:taskAffinity="com.android.settings">
            <intent-filter>
                <action android:name="com.android.axion.axionparts.action.PERFORMANCE" />
                <action android:name="com.android.axion.axionparts.action.BACKGROUND_MANAGER" />
                <action android:name="com.android.axion.axionparts.action.KERNEL_MANAGER" />
                <action android:name="com.android.axion.axionparts.action.RAM_PLUS" />
                <action android:name="com.android.axion.axionparts.ACTION_APP_OPTIMIZATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
